<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111217">

    <!-- Camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Close button (using material icon) -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:contentDescription="Close"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="12dp"/>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Scan Medicine"
        android:textStyle="bold"
        android:textSize="26sp"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnClose"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Point your camera at a Medicine and capture it."
        android:textSize="14sp"
        android:textColor="#D0D2D8"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="@id/tvTitle"
        android:layout_marginTop="6dp"/>

    <!-- Scrim overlay -->
    <View
        android:id="@+id/scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/><!-- semi-transparent black -->

    <!-- Scan window with yellow corners -->
    <FrameLayout
        android:id="@+id/scanWindow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnShutter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp">

        <!-- Top-left corner -->
        <View android:layout_width="36dp" android:layout_height="4dp"
            android:background="#FFD700" android:layout_gravity="start|top"/>
        <View android:layout_width="4dp" android:layout_height="36dp"
            android:background="#FFD700" android:layout_gravity="start|top"/>

        <!-- Top-right corner -->
        <View android:layout_width="36dp" android:layout_height="4dp"
            android:background="#FFD700" android:layout_gravity="end|top"/>
        <View android:layout_width="4dp" android:layout_height="36dp"
            android:background="#FFD700" android:layout_gravity="end|top"/>

        <!-- Bottom-left corner -->
        <View android:layout_width="36dp" android:layout_height="4dp"
            android:background="#FFD700" android:layout_gravity="start|bottom"/>
        <View android:layout_width="4dp" android:layout_height="36dp"
            android:background="#FFD700" android:layout_gravity="start|bottom"/>

        <!-- Bottom-right corner -->
        <View android:layout_width="36dp" android:layout_height="4dp"
            android:background="#FFD700" android:layout_gravity="end|bottom"/>
        <View android:layout_width="4dp" android:layout_height="36dp"
            android:background="#FFD700" android:layout_gravity="end|bottom"/>
    </FrameLayout>

    <!-- Upload from gallery (Material button without custom image) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpload"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Upload From Gallery"
        android:textAllCaps="false"
        android:icon="@android:drawable/ic_menu_upload"
        app:iconPadding="12dp"
        android:backgroundTint="@android:color/white"
        android:textColor="#111217"
        app:layout_constraintTop_toBottomOf="@id/scanWindow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-40dp"/>

    <!-- Shutter button (circle using background shape) -->
    <ImageButton
        android:id="@+id/btnShutter"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:background="@drawable/bg_shutter_circle"
        android:contentDescription="Capture"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
