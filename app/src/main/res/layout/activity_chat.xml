<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#23C262">

    <!-- Top bar -->
    <LinearLayout

        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:layout_gravity="top">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="98dp"
            android:text="Voice Assistant"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Center content -->
    <LinearLayout
        android:id="@+id/contentBox"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/tvListening"
            android:text="Tap the mic to speak"
            android:textColor="#E8FFF1"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- This shows your speech in quotes -->
        <TextView
            android:id="@+id/tvLiveQuote"
            android:text="“   ”"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="24sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Mic -->
        <FrameLayout
            android:id="@+id/micContainer"
            android:layout_marginTop="28dp"
            android:layout_width="160dp"
            android:layout_height="160dp">

            <View
                android:id="@+id/pulseRing"
                android:layout_gravity="center"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/ring_pulse"
                android:alpha="0.33" />

            <View
                android:id="@+id/micCircle"
                android:layout_gravity="center"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/mic_circle_bg" />

            <ImageView
                android:id="@+id/micIcon"
                android:layout_gravity="center"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:tint="#FFFFFF"
                android:src="@android:drawable/ic_btn_speak_now" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHint"
            android:text="Ask things like: “What is paracetamol used for?”"
            android:textColor="#E8FFF1"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvAssistant"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSwitchToText"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:layout_gravity="bottom|center_horizontal"
        android:enabled="false"
        android:alpha="0.6"
        android:text="Switch to Text Chat"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bottom_button_bg" />
</FrameLayout>
