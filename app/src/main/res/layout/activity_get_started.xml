<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen"
    android:padding="20dp">

    <!-- Main container (centered, kept above bottom) -->
    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_centerInParent="true"
        android:layout_above="@id/bottomContainer"
        android:layout_marginBottom="12dp">

        <!-- Title (auto-shrinks only if needed) -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Smart\nMedicine Companion"
            android:textStyle="bold"
            android:textColor="@color/green"
            android:gravity="start"
            android:layout_marginTop="0dp"
            android:textSize="26sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="22sp"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeStepGranularity="1sp"/>

        <!-- Subtitle (auto-shrinks only if needed) -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Stay on track with your health. Scan prescriptions, set reminders, connect with your doctors, and never miss a dose again."
            android:textColor="@android:color/holo_green_dark"
            android:gravity="start"
            android:lineSpacingExtra="2dp"
            android:textSize="13sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeStepGranularity="1sp"/>

        <!-- Illustration (exact same size as yours) -->
        <ImageView
            android:id="@+id/ivIllustration"
            android:layout_width="414dp"
            android:layout_height="322dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="Illustration"
            android:scaleType="fitCenter"
            android:src="@drawable/logo2" />

        <!-- Dots -->
        <LinearLayout
            android:id="@+id/dotsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:layout_gravity="center">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="5dp"
                android:background="@drawable/dot_active" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="5dp"
                android:background="@drawable/dot_inactive" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom section pinned to bottom -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvSmallSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Stay on track with your health. Scan prescriptions, set reminders, connect with your doctors, and never miss a dose again."
            android:textColor="@android:color/holo_green_dark"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/green"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="Get Started"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:layout_marginBottom="0dp" />

        <Button
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/white"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="Don’t have an account?"
            android:textAllCaps="false"
            android:textColor="@android:color/black" />
    </LinearLayout>

</RelativeLayout>
